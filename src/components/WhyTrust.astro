---

---

<section
  id="why-trust"
  class="relative py-16 lg:py-24 overflow-hidden flex items-center bg-background-dark border-t border-white/5"
>
  <!-- Background Image with Sophisticated Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://dharmaputrainterior.co.id/images/1024/15690116/Punika-Deli-111-ng1BqIAqVtUEDlJ8tivrLA.jpg"
      alt="Why Trust Us Background"
      class="w-full h-full object-cover grayscale opacity-20"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-background-dark via-background-dark/95 to-transparent"></div>
  </div>

  <!-- Floating Elements (Subtle) -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none opacity-20">
    <div class="absolute top-1/4 left-1/4 w-48 h-48 border border-white/10 rounded-full animate-float-slow"></div>
    <div class="absolute bottom-1/4 right-1/4 w-72 h-72 border border-white/10 rotate-45 animate-float-slower"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row gap-16 items-start">
      
      <!-- Side Header (Left Column - 1/3) -->
      <div class="lg:w-1/3 space-y-8 reveal">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 backdrop-blur-md">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            <span class="text-[9px] font-bold tracking-[0.2em] text-primary uppercase">The ASD Promise</span>
          </div>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-white font-bold leading-[1.1]">
            Why Our <span class="text-gradient-accent">Partners Trust Us</span>
          </h2>
        </div>
        
        <div class="space-y-6">
          <p class="text-white/40 text-base md:text-lg font-light leading-relaxed border-l-2 border-primary/30 pl-6">
            "We believe that every architectural detail is a buildable piece of trust. Our commitment extends beyond the physical structure into the lasting relationships we build with every client."
          </p>
          <div class="flex items-center gap-4 group cursor-pointer lg:justify-start">
            <div class="w-12 h-[1px] bg-primary group-hover:w-16 transition-all duration-500"></div>
            <span class="text-[10px] font-bold tracking-widest text-white/50 group-hover:text-white transition-colors uppercase">Explore Our Philosophy</span>
          </div>
        </div>
      </div>

      <!-- Feature Grid (Right Column - 2/3) -->
      <div class="lg:w-2/3">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-6">
          {
            [
              {
                title: "Quality First",
                desc: "Prioritize high quality standards in every process.",
                icon: "military_tech"
              },
              {
                title: "Customer Focus",
                desc: "Client satisfaction is our top priority.",
                icon: "groups_3"
              },
              {
                title: "Safety & Durability",
                desc: "Every product is designed with ergonomics in mind.",
                icon: "verified_user"
              },
              {
                title: "Innovation",
                desc: "Continuously adapt to design trends, production technologies and market needs to create relevant and modern solutions.",
                icon: "tips_and_updates"
              },
              {
                title: "On-Time Delivery",
                desc: "Well-scheduled production process, commitment to delivery deadlines, clear communication throughout the process",
                icon: "local_shipping"
              },
              {
                title: "Customized",
                desc: "Exclusive designs tailored to the customer's space concept.",
                icon: "design_services"
              },
            ].map((item, index) => (
              <div 
                class="trust-card group relative p-6 bg-white/[0.02] border border-white/5 rounded-xl transition-all duration-500 reveal hover:border-primary/30"
                style={`transition-delay: ${index * 100}ms`}
              >
                <!-- Spotlight Glow -->
                <div class="spotlight absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none bg-[radial-gradient(circle_at_var(--x)_var(--y),rgba(228,34,46,0.1)_0%,transparent_60%)]"></div>
                
                <div class="relative z-10 flex gap-5 items-start">
                  <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center group-hover:bg-primary/20 group-hover:border-primary/40 transition-all duration-500 shadow-xl">
                    <span class="material-icons-outlined text-2xl text-primary/70 group-hover:text-primary group-hover:rotate-6 transition-all duration-500">
                      {item.icon}
                    </span>
                  </div>
                  
                  <div class="space-y-2">
                    <h3 class="font-display text-lg font-bold text-white group-hover:text-primary transition-colors">
                      {item.title}
                    </h3>
                    <p class="text-white/40 text-sm leading-snug group-hover:text-white/70 transition-colors">
                      {item.desc}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .animate-float-slow {
    animation: float 20s infinite linear;
  }
  .animate-float-slower {
    animation: float 30s infinite linear reverse;
  }
  @keyframes float {
    0% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(20px, -30px) rotate(5deg); }
    66% { transform: translate(-10px, 15px) rotate(-5deg); }
    100% { transform: translate(0, 0) rotate(0deg); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const initInteractions = () => {
    const cards = document.querySelectorAll('.trust-card');
    cards.forEach(card => {
      card.addEventListener('mousemove', (e: any) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        (card as HTMLElement).style.setProperty('--x', `${x}px`);
        (card as HTMLElement).style.setProperty('--y', `${y}px`);
      });
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  };

  document.addEventListener('DOMContentLoaded', initInteractions);
  document.addEventListener('astro:page-load', initInteractions);
</script>
