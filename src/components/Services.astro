---
---

<section
  id="services"
  class="relative py-16 lg:py-24 overflow-hidden bg-white border-t border-slate-50"
>
  <div class="max-w-7xl mx-auto px-6 mb-16 reveal">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-10">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 backdrop-blur-md">
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
          <span class="text-[9px] font-bold tracking-[0.3em] text-primary uppercase">Expertise & Innovation</span>
        </div>
        <h2 class="font-display text-4xl md:text-6xl text-slate-800 font-bold tracking-tight leading-none">
          Our <span class="italic text-primary">Services</span>
        </h2>
      </div>
      <div class="max-w-md">
        <p class="text-slate-500 text-base font-light leading-relaxed border-l border-primary/20 pl-6">
          "Architecture is a visual language. We speak it through bespoke design and precision manufacturing, without the need for noise—only clarity and craft."
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- Architectural Accordion Container -->
    <div class="flex flex-col lg:flex-row gap-4 h-auto lg:h-[500px] w-full group/accordion">
      {
        [
          {
            index: "01",
            title: "Interior Design",
            subtitle: "Space Orchestration",
            desc: "Comprehensive interior design services, including ceiling and partition installation, flooring, furniture procurement, and modular or custom kitchen set production.",
            pattern: "bg-[radial-gradient(#e4222e08_1px,transparent_1px)] [background-size:20px_20px]"
          },
          {
            index: "02",
            title: "Furniture Production",
            subtitle: "Artisanal Joinery",
            desc: "We utilize solid wood and multiplex (plywood) as base materials, with finishes including HPL sheets, duco paint, melamine, and NC (nitrocellulose).",
            pattern: "bg-[linear-gradient(45deg,#e4222e08_25%,transparent_25%,transparent_50%,#e4222e08_50%,#e4222e08_75%,transparent_75%,transparent)] [background-size:30px_30px]"
          },
          {
            index: "03",
            title: "Wall Decoration",
            subtitle: "Atmospheric Surfaces",
            desc: "Professional backwall and wall feature services, offering a variety of materials including plywood (multiplex), wallpaper, wall stickers, digital printed art, and palette knife paintings.",
            pattern: "bg-[repeating-linear-gradient(90deg,transparent,transparent_20px,#e4222e05_20px,#e4222e05_21px)]"
          },
          {
            index: "04",
            title: "Manufacturing",
            subtitle: "Industrial Standards",
            desc: "All manufacturing processes and stages are carried out in strict accordance with Standard Operating Procedures (SOP).",
            pattern: "bg-[linear-gradient(transparent_0%,#e4222e08_50%,transparent_100%)] [background-size:100%_4px]"
          }
        ].map((service) => (
          <div 
            class="service-panel group relative flex-1 lg:hover:flex-[2.5] flex flex-col bg-white border border-slate-100 lg:border-transparent lg:shadow-sm hover:shadow-xl hover:border-primary/20 transition-all duration-700 overflow-hidden cursor-pointer"
          >
            <!-- Pattern Background -->
            <div class={`absolute inset-0 opacity-40 group-hover:opacity-60 transition-opacity duration-700 ${service.pattern}`}></div>
            
            {/* Active Accent Glow */}
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-transparent via-primary/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            
            <div class="relative z-10 p-8 lg:p-10 flex flex-col h-full justify-between">
              <div class="flex justify-between items-start">
                <div class="space-y-1">
                  <span class="text-4xl lg:text-5xl font-display font-light text-slate-200 group-hover:text-primary transition-colors">
                    {service.index}
                  </span>
                </div>
                {/* Mini Icon placeholder/indicator */}
                <div class="w-8 h-8 rounded-full border border-slate-100 flex items-center justify-center group-hover:bg-primary group-hover:border-primary transition-all">
                   <div class="w-1.5 h-1.5 rounded-full bg-slate-200 group-hover:bg-white transition-colors"></div>
                </div>
              </div>

              <div class="space-y-6">
                <div class="space-y-2">
                  <h3 class="font-display text-2xl lg:text-3xl font-bold text-slate-800 group-hover:text-primary transition-colors">
                    {service.title}
                  </h3>
                  <p class="text-[10px] font-bold tracking-[0.3em] text-slate-400 uppercase">
                    {service.subtitle}
                  </p>
                </div>

                <!-- Expanded Content -->
                <div class="max-h-0 lg:group-hover:max-h-32 opacity-0 lg:group-hover:opacity-100 transition-all duration-700 overflow-hidden">
                   <p class="text-slate-500 text-sm lg:text-base font-light leading-relaxed max-w-sm">
                      {service.desc}
                   </p>
                </div>
                
                <!-- Mobile only description visibility -->
                <div class="lg:hidden mt-4 pt-4 border-t border-slate-50">
                   <p class="text-slate-500 text-sm font-light leading-relaxed">
                      {service.desc}
                   </p>
                </div>
              </div>
            </div>
            
            <!-- Side index for collapsed desktop view -->
            <div class="absolute right-6 top-1/2 -translate-y-1/2 rotate-90 hidden lg:block transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:translate-x-4 whitespace-nowrap">
               <span class="text-[10px] font-bold tracking-[0.5em] text-slate-400 uppercase">{service.title}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .font-display {
    font-family: 'Playfair Display', serif;
  }
  .text-primary-200 {
    color: #ffd7d7;
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: all 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const initServicesAccordion = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  };

  document.addEventListener('DOMContentLoaded', initServicesAccordion);
  document.addEventListener('astro:page-load', initServicesAccordion);
</script>
