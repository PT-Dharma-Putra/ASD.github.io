---

---

<section
  class="relative min-h-[80vh] flex items-center overflow-hidden bg-background-dark py-24"
>
  <!-- Background Image with Professional Overlays -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://dharmaputrainterior.co.id/images/1024/15690116/Punika-Deli-111-ng1BqIAqVtUEDlJ8tivrLA.jpg"
      alt="Project Consultation Background"
      class="w-full h-full object-cover scale-105 opacity-40 grayscale"
    />
    <!-- Sophisticated Layered Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-background-dark via-background-dark/95 to-primary/20"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_70%_50%,rgba(228,34,46,0.15),transparent_50%)]"
    >
    </div>
  </div>

  <!-- Decorative Background Text -->
  <div
    class="absolute top-1/2 left-0 -translate-y-1/2 select-none pointer-events-none opacity-[0.03] z-0 overflow-hidden hidden lg:block"
  >
    <span
      class="font-display text-[25rem] font-black leading-none tracking-tighter text-white"
    >
      ASD
    </span>
  </div>

  <!-- Noise Texture -->
  <div
    class="absolute inset-0 z-[1] opacity-20 pointer-events-none mix-blend-overlay bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10 w-full">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left Column: Compelling Typography -->
      <div class="space-y-8 text-left max-w-2xl">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 backdrop-blur-md mb-4"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"
          ></span>
          <span
            class="text-[10px] font-bold tracking-[0.4em] text-primary uppercase"
            >Next-Level Interiors</span
          >
        </div>

        <h2
          class="font-display text-5xl md:text-7xl lg:text-8xl text-white font-bold leading-[0.95] tracking-tighter"
        >
          Want To Start <br />
          <span class="text-gradient-accent italic block mt-2"
            >A New Project?</span
          >
        </h2>

        <div class="relative pl-8 border-l border-white/10">
          <p
            class="text-white/60 text-lg md:text-xl font-light italic leading-relaxed"
          >
            "Feel free to talk, share your dream imagination and let us make it
            into reality"
          </p>
        </div>
      </div>

      <!-- Right Column: Interactive Glass Card -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative group w-full max-w-md">
          <!-- Card Glow -->
          <div
            class="absolute -inset-1 bg-gradient-to-r from-primary/50 to-accent-orange/50 rounded-3xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"
          >
          </div>

          <div
            class="relative flex flex-col items-center p-10 md:p-14 bg-white/[0.03] backdrop-blur-2xl border border-white/10 rounded-3xl shadow-2xl overflow-hidden"
          >
            <!-- Decorative circle -->
            <div
              class="absolute -top-20 -right-20 w-40 h-40 bg-primary/10 rounded-full blur-3xl"
            >
            </div>

            <div class="mb-10 text-center space-y-4">
              <h3
                class="text-white font-display text-2xl font-bold tracking-tight"
              >
                Ready to collaborate?
              </h3>
              <p class="text-white/40 text-sm">
                Our experts are waiting to bring your vision to life.
              </p>
            </div>

            <a
              href="https://wa.me/6281128507788"
              target="_blank"
              class="group/btn relative w-full inline-flex items-center justify-center gap-4 px-8 py-5 bg-primary text-white font-bold rounded-2xl overflow-hidden shadow-xl shadow-primary/20 transition-all duration-500 hover:-translate-y-1 hover:shadow-primary/40 active:scale-95"
            >
              <!-- Shimmer Effect -->
              <span
                class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full group-hover/btn:translate-x-full transition-transform duration-1000"
              ></span>

              <span class="font-display text-lg tracking-widest uppercase"
                >CONTACT US</span
              >
              <span
                class="material-icons-outlined text-xl group-hover/btn:translate-x-1 transition-transform"
                >arrow_forward</span
              >
            </a>

            <div class="mt-10 flex flex-col items-center gap-6">
              <div class="flex items-center gap-3">
                <div class="flex -space-x-2">
                  {
                    [1, 2, 3].map(() => (
                      <div class="w-8 h-8 rounded-full border-2 border-background-dark bg-slate-800" />
                    ))
                  }
                </div>
                <span
                  class="text-white/30 text-[10px] font-bold uppercase tracking-wider"
                  >Join 500+ Happy Clients</span
                >
              </div>

              <div class="flex items-center gap-4 text-white/20">
                <div class="h-px w-8 bg-white/10"></div>
                <span class="text-[9px] font-bold uppercase tracking-[0.3em]"
                  >Consultation is Free</span
                >
                <div class="h-px w-8 bg-white/10"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .text-gradient-accent {
    background: linear-gradient(135deg, #fff 0%, #e4222e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
