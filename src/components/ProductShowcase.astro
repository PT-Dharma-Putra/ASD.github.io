---
import { projectsData } from "../data/projects.js";
import fs from "node:fs";
import path from "node:path";

const projectsWithImages = projectsData.map((project) => {
  let displayImage = project.image;

  if (project.folderName) {
    try {
      const folderPath = path.join(
        process.cwd(),
        "public",
        "images",
        "project",
        project.folderName,
      );
      if (fs.existsSync(folderPath)) {
        const files = fs.readdirSync(folderPath);
        const imageFiles = files.filter((file) => {
          const ext = path.extname(file).toLowerCase();
          return [".jpg", ".jpeg", ".png", ".webp"].includes(ext);
        });

        if (imageFiles.length > 0) {
          // Use the first image from the folder
          displayImage = `/images/project/${project.folderName}/${imageFiles[0]}`;
        }
      }
    } catch (e) {
      console.error(`Error loading images for ${project.title}:`, e);
    }
  }

  return {
    ...project,
    displayImage,
  };
});
---

<section id="projects" class="py-24 bg-zinc-50">
  <div class="max-w-7xl mx-auto px-6">
    <div
      class="mb-16 flex flex-col md:flex-row justify-between items-end gap-6 border-b border-primary/10 pb-12"
    >
      <div>
        <span
          class="text-primary font-bold tracking-[0.2em] uppercase text-sm mb-2 block"
          >Our Portfolio</span
        >
        <h2 class="font-display text-5xl text-secondary font-bold mb-4">
          OUR PROJECTS
        </h2>
        <p class="text-slate-500 max-w-xl">
          Discover how Abhijati Sahar Dharma turns ideas into reality through a
          collection of completed projects.
        </p>
      </div>
    </div>
    <div class="embla overflow-hidden" id="projects-carousel">
      <div class="embla__container flex">
        {
          projectsWithImages.map((project) => (
            <div class="embla__slide flex-[0_0_100%] md:flex-[0_0_50%] lg:flex-[0_0_33.333%] min-w-0 px-4">
              <a
                href={`/projects/${project.slug}`}
                class="group cursor-pointer block h-full"
              >
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-500 overflow-hidden mb-4 relative aspect-[4/3]">
                  <img
                    alt={project.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                    src={project.displayImage}
                    onerror="this.src='https://placehold.co/800x600?text=Project+Image'"
                  />
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-500" />
                  <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/80 to-transparent text-white translate-y-4 group-hover:translate-y-0 transition-transform">
                    <p class="text-xs font-bold uppercase tracking-wider mb-1 text-accent-orange">
                      {project.category}
                    </p>
                    <h3 class="font-display text-xl font-bold">
                      {project.title}
                    </h3>
                  </div>
                </div>
                <div class="px-2">
                  <p class="text-sm text-slate-500 line-clamp-2">
                    {project.description}
                  </p>
                </div>
              </a>
            </div>
          ))
        }
      </div>

      <!-- Navigation Buttons -->
      <div class="flex justify-center items-center gap-6 mt-12">
        <button
          class="w-12 h-12 rounded-full bg-white shadow-lg flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all duration-300"
          id="project-prev"
          aria-label="Previous project"
        >
          <span class="material-icons-outlined">chevron_left</span>
        </button>

        <div class="flex gap-2" id="project-dots"></div>

        <button
          class="w-12 h-12 rounded-full bg-white shadow-lg flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all duration-300"
          id="project-next"
          aria-label="Next project"
        >
          <span class="material-icons-outlined">chevron_right</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .embla__slide {
    padding-left: 1rem;
    padding-right: 1rem;
  }
</style>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  const setupCarousel = () => {
    const emblaNode = document.querySelector(
      "#projects-carousel",
    ) as HTMLElement;
    const dotsNode = document.querySelector("#project-dots") as HTMLElement;
    const prevBtn = document.querySelector("#project-prev") as HTMLElement;
    const nextBtn = document.querySelector("#project-next") as HTMLElement;

    if (!emblaNode) return;

    const emblaApi = EmblaCarousel(
      emblaNode,
      {
        loop: true,
        align: "start",
        slidesToScroll: 1,
        breakpoints: {
          "(min-width: 768px)": { slidesToScroll: 2 },
          "(min-width: 1024px)": { slidesToScroll: 1 }, // Scroll 1 by 1 for smoother feel or leave as 1
        },
      },
      [Autoplay({ delay: 5000, stopOnInteraction: false })],
    );

    // Generate dots
    const slides = emblaApi.scrollSnapList();
    if (dotsNode) {
      dotsNode.innerHTML = slides
        .map(
          () =>
            `<button class="w-2 h-2 rounded-full bg-primary/20 transition-all duration-300"></button>`,
        )
        .join("");

      const dots = Array.from(dotsNode.children) as HTMLElement[];

      const updateDots = () => {
        const selected = emblaApi.selectedScrollSnap();
        dots.forEach((dot, i) => {
          if (i === selected) {
            dot.classList.add("w-6", "bg-primary");
            dot.classList.remove("bg-primary/20");
          } else {
            dot.classList.remove("w-6", "bg-primary");
            dot.classList.add("bg-primary/20");
          }
        });
      };

      emblaApi.on("select", updateDots);
      emblaApi.on("init", updateDots);
      updateDots();

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          emblaApi.scrollTo(i);
          emblaApi.plugins().autoplay.stop();
        });
      });
    }

    // Button listeners
    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        emblaApi.scrollPrev();
        emblaApi.plugins().autoplay.stop();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        emblaApi.scrollNext();
        emblaApi.plugins().autoplay.stop();
      });
    }
  };

  document.addEventListener("DOMContentLoaded", setupCarousel);
  document.addEventListener("astro:page-load", setupCarousel);
</script>
