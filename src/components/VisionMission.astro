---

---

<section id="vision-mission" class="relative bg-white overflow-hidden py-32">
  <!-- Subtle Background Pattern -->
  <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.03]">
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(circle at 2px 2px, #E4222E 1px, transparent 0); background-size: 40px 40px;"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-24 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-4 mb-6">
        <div class="h-[1px] w-12 bg-primary/30"></div>
        <span class="text-primary font-bold tracking-[0.3em] uppercase text-xs"
          >Commitment to Excellence</span
        >
        <div class="h-[1px] w-12 bg-primary/30"></div>
      </div>
      <h2
        class="font-display text-5xl md:text-6xl text-secondary font-bold mb-8 leading-tight"
      >
        OUR <span class="text-gradient-primary">VISION</span> & <span
          class="text-gradient-primary">MISSION</span
        >
      </h2>
      <p class="text-slate-500 text-lg font-light leading-relaxed">
        Guided by innovation and excellence, we strive to build a sustainable
        future in the interior manufacturing industry.
      </p>
    </div>

    <!-- Redesigned Grid -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-24 items-stretch">
      <!-- Vision Card -->
      <div class="group relative flex flex-col justify-center">
        <!-- Floating Icon Watermark -->
        <div
          class="absolute -top-10 -left-10 text-[15rem] leading-none text-primary/5 font-bold select-none pointer-events-none group-hover:text-primary/10 transition-colors duration-700 font-display"
        >
          V
        </div>

        <div
          class="relative z-10 space-y-8 pl-8 md:pl-12 border-l-2 border-primary/10 group-hover:border-primary transition-colors duration-700"
        >
          <div class="flex items-center gap-6">
            <div
              class="w-16 h-16 rounded-full bg-secondary text-white flex items-center justify-center shadow-2xl group-hover:bg-primary transition-colors duration-500"
            >
              <span class="material-icons-outlined text-3xl">track_changes</span
              >
            </div>
            <h3
              class="font-display text-4xl font-bold text-secondary uppercase tracking-wider"
            >
              Vision
            </h3>
          </div>

          <p
            class="text-2xl md:text-3xl text-secondary/80 font-display leading-[1.4] italic"
          >
            "To become a company in the interior furniture manufacturing
            industry that consistently implements a
            <span class="text-primary not-italic font-bold"
              >green factory approach</span
            >, specializing in serving hospitals, pharmaceutical facilities,
            laboratories, clinics, and other medical service sectors."
          </p>

          <div class="flex items-center gap-3 text-slate-400">
            <div class="h-[1px] w-8 bg-slate-200"></div>
            <span class="text-sm uppercase tracking-widest font-bold"
              >The Gold Standard</span
            >
          </div>
        </div>
      </div>

      <!-- Mission Card -->
      <div
        class="group relative bg-slate-50/50 p-10 md:p-16 rounded-[2.5rem] border border-slate-100 transition-all duration-700 hover:bg-white hover:shadow-[0_40px_100px_-20px_rgba(228,34,46,0.1)] hover:-translate-y-2 overflow-hidden"
      >
        <!-- Floating Icon Watermark -->
        <span
          class="absolute -bottom-10 -right-10 material-icons-outlined text-[12rem] text-primary/5 rotate-12 group-hover:rotate-0 transition-all duration-1000"
        >
          assignment
        </span>

        <div class="relative z-10">
          <div class="flex items-center gap-6 mb-12">
            <h3
              class="font-display text-4xl font-bold text-secondary uppercase tracking-wider underline decoration-primary/30 underline-offset-8"
            >
              Mission
            </h3>
          </div>

          <div class="grid gap-10">
            {
              [
                {
                  title: "Innovation First",
                  desc: "To deliver innovative products that keep up with current trends and market demands.",
                },
                {
                  title: "Service Excellence",
                  desc: "To provide friendly, fast, and professional services while maintaining customer satisfaction.",
                },
                {
                  title: "Sustainability",
                  desc: "To create a positive working environment and preserve environmental sustainability.",
                },
                {
                  title: "3T Principles",
                  desc: "To produce high-quality products by prioritizing: On-time delivery, Quality compliance, and Budget accuracy.",
                },
              ].map((mission) => (
                <div class="flex gap-6 group/item">
                  <div class="shrink-0 w-10 h-10 rounded-xl bg-white shadow-sm border border-slate-100 flex items-center justify-center text-primary group-hover/item:bg-primary group-hover/item:text-white transition-all duration-300">
                    <span class="material-icons-outlined text-xl">
                      done_all
                    </span>
                  </div>
                  <div>
                    <h4 class="font-bold text-secondary mb-1 text-lg group-hover/item:text-primary transition-colors">
                      {mission.title}
                    </h4>
                    <p class="text-slate-500 leading-relaxed font-light">
                      {mission.desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .text-gradient-primary {
    background: linear-gradient(135deg, #e4222e 0%, #991b1b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
